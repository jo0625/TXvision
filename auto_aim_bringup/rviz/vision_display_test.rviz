Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: ArmorDetection
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /detector/result_img
      Value: true
  Global Options:
    Fixed Frame: odom
  Name: root
Window Geometry:
  Height: 900
  Width: 1280
