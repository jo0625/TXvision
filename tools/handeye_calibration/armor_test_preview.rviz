Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /detector/result_img
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: ArmorDetection
      Normalize Range: true
      Value: true
  Global Options:
    Fixed Frame: odom
  Name: root
Window Geometry:
  Height: 900
  Width: 1280
